{
  "headers": [
    {
      "source": "/((?!data/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" = fix/sec-owner-attribution-2026-11-26",
  "buildCommand": "",
  "installCommand": ""
}
